#!/bin/sh
# Full gate before anything reaches origin/CI. Bypass: git push --no-verify
echo "stator: pre-push gate — typecheck + tests"
# Dots instead of a line per test: a failure still prints its full assertion
# and stack, but a green run is a few lines rather than thousands.
pnpm typecheck && NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--test-reporter=dot" pnpm test
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "stator: pre-push gate failed — nothing was pushed."
  echo "  bypass (rarely): git push --no-verify"
  exit $status
fi
