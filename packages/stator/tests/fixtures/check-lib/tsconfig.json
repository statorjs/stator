{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "jsx": "preserve",
    "rootDirs": [".", ".stator/types", ".stator/check"]
  },
  "include": ["src", ".stator/check/**/*.tsx"],
  "exclude": ["src/**/*.stator.ts", "src/**/*.stator.client.ts"]
}
