<fixture-counter>
  <button type="button" on:click={bump}>+1</button>
  <output on:click={reset}></output>
</fixture-counter>

<script>
  export class FixtureCounter extends StatorElement {
    count = 0

    bump() {
      this.count += 1
      const label: number = `count ${this.count}`
      this.querySelector('output')!.textContent = String(label)
    }

    reset(to: number) {
      this.count = to
    }
  }
</script>
