---
import { getImage, type ImageProps } from './images.ts'

const p = Stator.props<ImageProps>()
const {
  alt,
  class: className,
  sizes = '100vw',
  priority,
  loading = priority ? 'eager' : 'lazy',
  fetchpriority = priority ? 'high' : undefined,
  decoding = 'async',
} = p
const img = getImage(p)
---
<img
  src={img.src}
  srcset={img.srcset ?? undefined}
  sizes={img.srcset ? sizes : undefined}
  alt={alt}
  width={img.width}
  height={img.height}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding={decoding}
  class={className}
/>

<style>
  /* The responsive-image baseline every <Image>/<Picture> gets for free:
     block (not inline, which leaves a descender-height gap under the image)
     and constrained to its container while height:auto preserves the
     intrinsic aspect ratio the width/height attributes already declare.
     Anything past this — radius, margin, object-fit — is the app's call. */
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
