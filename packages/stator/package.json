{
  "name": "@statorjs/stator",
  "version": "3.0.0-next.4",
  "description": "Server-canonical web framework: business logic in composable state machines, UI as a thin renderer binding machine outputs to DOM positions. Ships TypeScript source, loaded natively by its own toolchain — no build step.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statorjs/stator.git",
    "directory": "packages/stator"
  },
  "homepage": "https://github.com/statorjs/stator#readme",
  "bugs": "https://github.com/statorjs/stator/issues",
  "keywords": [
    "framework",
    "server-canonical",
    "state-machine",
    "ssr",
    "sse",
    "islands"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "bin": {
    "stator": "./src/cli/stator.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./server/runtime": {
      "types": "./src/server/runtime.ts",
      "default": "./src/server/runtime.ts"
    },
    "./machine": {
      "types": "./src/engine/index.ts",
      "default": "./src/engine/index.ts"
    },
    "./dev": {
      "types": "./src/server/dev.ts",
      "default": "./src/server/dev.ts"
    },
    "./register": "./src/register.js",
    "./test-env": "./src/test-env.ts",
    "./build": {
      "types": "./src/build/index.ts",
      "default": "./src/build/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./template": {
      "types": "./src/template/index.ts",
      "default": "./src/template/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./components.css": "./src/components/components.css",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./compiler": {
      "types": "./src/compiler/index.ts",
      "default": "./src/compiler/index.ts"
    },
    "./editor": {
      "types": "./src/editor.ts",
      "default": "./src/editor.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import @statorjs/stator/register --import @statorjs/stator/test-env --test --test-force-exit --test-timeout=60000 'tests/**/*.test.ts'",
    "test:watch": "node --import @statorjs/stator/register --import @statorjs/stator/test-env --test --watch 'tests/**/*.test.ts'",
    "test:browser": "node browser-tests/tables.mjs",
    "build:client": "esbuild src/client/runtime.ts --bundle --format=iife --target=es2020 --outfile=dist/client.js",
    "build:components": "node src/cli/stator.js build:lib src/components && biome check --write src/components/",
    "contract:refresh": "node --import @statorjs/stator/register scripts/refresh-contract.ts",
    "prepublishOnly": "pnpm run build:components"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "ioredis": "^5.10.1",
    "pino": "^10.4.0",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "schema-dts": "^1.1.5",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@statorjs/stator": "workspace:*",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "pino-pretty": "^13.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
