<variant-picker>
  <div class="vp-stage" ref:stage>{props.plate}</div>
  <div class="vp-row">
    <span class="vp-caption">Color · <span>{read(sel, (s) => s.colorLabel)}</span></span>
    <div class="vp-swatches" role="radiogroup" aria-label="Colorway" on:change={pickColor}>
      {props.colorways.map((c) => (
        <label class="vp-swatch" title={c.label} style={`background:${c.swatch}`}>
          <input
            type="radio"
            name="vp-color"
            value={c.value}
            data-label={c.label}
            checked={c.value === props.initialColor}
          />
        </label>
      ))}
    </div>
  </div>
  <div class="vp-row">
    <span class="vp-caption">Size · <span>{read(sel, (s) => s.sizeLabel)}</span></span>
    <div class="vp-sizes" role="radiogroup" aria-label="Size" on:change={pickSize}>
      {props.sizes.map((sz) => (
        <label class="vp-size">
          <input type="radio" name="vp-size" value={sz} checked={sz === props.initialSize} />
          {sz === 'one-size' ? 'One size' : sz}
        </label>
      ))}
    </div>
  </div>
  <div class="vp-row">
    <button class="btn-primary vp-add" type="button" on:click={add} disabled={read(sel, (s) => s.out)}>
      Add to cart
    </button>
    <p class="vp-status" role="status">{read(sel, (s) => s.status)}</p>
  </div>
</variant-picker>

<script>
  import { plateStyleOf } from '../lib/colorways.ts'
  import CartMachine from '../machines/cart.ts'

  /** The sku grammar this island shares with the server (lib/sku.ts parses it back). */
  const skuFor = (s: { slug: string; color: string; size: string }) =>
    `${s.slug}--${s.color}--${s.size}`

  // Which variant is the shopper looking at — ephemeral, client-owned.
  // The option radios and the plate are SERVER-RENDERED from props (the
  // hydrate pattern): the radios' :checked state carries the selection in
  // the DOM, this machine mirrors it for display and the add commit. The
  // ack is view state — it lives here and dies with the page.
  const Sel = machine(
    {
      slug: '',
      color: '',
      colorLabel: '',
      size: '',
      stock: {} as Record<string, number>,
      ack: null as 'added' | 'refused' | 'failed' | null,
    },
    {
      events: {} as
        | { type: 'PICK_COLOR'; color: string; label: string }
        | { type: 'PICK_SIZE'; size: string }
        | { type: 'STOCK'; stock: Record<string, number> }
        | { type: 'ADDED' }
        | { type: 'REFUSED' }
        | { type: 'FAILED' }
        | { type: 'CLEAR_ACK' },
      on: {
        PICK_COLOR: (s, ev) => {
          s.color = ev.color
          s.colorLabel = ev.label
          s.ack = null
        },
        PICK_SIZE: (s, ev) => {
          s.size = ev.size
          s.ack = null
        },
        STOCK: (s, ev) => {
          s.stock = ev.stock
        },
        ADDED: (s) => {
          s.ack = 'added'
        },
        REFUSED: (s) => {
          s.ack = 'refused'
        },
        FAILED: (s) => {
          s.ack = 'failed'
        },
        CLEAR_ACK: (s) => {
          s.ack = null
        },
      },
      select: {
        sku: (s) => skuFor(s),
        sizeLabel: (s) => (s.size === 'one-size' ? 'One size' : `EU ${s.size}`),
        out: (s) => (s.stock[skuFor(s)] ?? -1) === 0,
        status: (s) => {
          if (s.ack === 'added') return 'Added ✓'
          if (s.ack === 'refused') return 'No more in stock'
          if (s.ack === 'failed') return 'Something slipped — try again'
          return (s.stock[skuFor(s)] ?? -1) === 0 ? 'Out of stock' : ''
        },
      },
    },
  )

  export class VariantPicker extends StatorElement {
    static attrs = {
      slug: String,
      /** Live JSON map sku→qty, server-bound on the PDP route — every patch
       *  re-parses through this coercer and lands in stockChanged(). */
      stock: (raw: string) => JSON.parse(raw) as Record<string, number>,
      initialColor: String,
      initialColorLabel: String,
      initialSize: String,
    }

    sel = use(Sel, () => ({
      slug: String(this.attrs.slug ?? ''),
      color: String(this.attrs.initialColor ?? ''),
      colorLabel: String(this.attrs.initialColorLabel ?? ''),
      size: String(this.attrs.initialSize ?? ''),
      stock: (this.attrs.stock ?? {}) as Record<string, number>,
    }))

    connectedCallback() {
      super.connectedCallback()
      this.track(effect([this.sel], () => this.reflectSelection()))
    }

    /** Live server state arriving through the declared-attr channel, forwarded
     *  into the client machine as a typed event — display follows via read(). */
    stockChanged(next?: Record<string, number>) {
      this.sel.send({ type: 'STOCK', stock: next ?? {} })
    }

    pickColor(e: Event) {
      const input = e.target as HTMLInputElement
      this.sel.send({ type: 'PICK_COLOR', color: input.value, label: input.dataset.label ?? '' })
    }

    pickSize(e: Event) {
      const input = e.target as HTMLInputElement
      this.sel.send({ type: 'PICK_SIZE', size: input.value })
    }

    /** Commit the chosen variant to the SERVER cart — the one visible
     *  boundary crossing in this island. */
    async add() {
      const result = await dispatch(CartMachine, { type: 'ADD', sku: this.sel.sku })
      // Three different facts: transport, commit, patches. The ack follows
      // COMMIT — a guard-dropped add must not claim success.
      this.sel.send({ type: result.committed ? 'ADDED' : result.ok ? 'REFUSED' : 'FAILED' })
      setTimeout(() => this.sel.send({ type: 'CLEAR_ACK' }), 1800)
    }

    /** The two writes still outside read()'s reach, in one tracked effect: the
     *  server-rendered Plate carries its own inline color variables (which
     *  shadow any ancestor's), and the badge strip belongs to the route,
     *  outside this island. Per-element class marking across mapped markup
     *  has no declarative form yet. */
    reflectSelection() {
      const plate = this.refs.stage?.querySelector('.plate') as HTMLElement | null
      if (plate) plate.style.cssText = plateStyleOf(this.sel.color)
      for (const b of document.querySelectorAll('[data-stock-badges] .stock-badge')) {
        b.classList.toggle('is-shown', (b as HTMLElement).dataset.sku === this.sel.sku)
      }
    }
  }
</script>

<style>
  variant-picker { display: block; }
  .vp-stage { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 12px; }
  .vp-stage svg, .vp-stage .plate svg { display: block; width: 100%; height: auto; }
  .vp-row { margin-top: 14px; }
  .vp-caption {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--harbor);
    margin-bottom: 8px;
  }
  .vp-swatches { display: flex; flex-wrap: wrap; gap: 10px; }
  .vp-sizes { display: flex; flex-wrap: wrap; gap: 6px; }
  .vp-swatch input,
  .vp-size input {
    position: absolute;
    opacity: 0;
    margin: 0;
    pointer-events: none;
  }
  .vp-swatch {
    position: relative;
    width: 32px; height: 32px; border-radius: 50%;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
    transition: transform 0.12s ease;
  }
  .vp-swatch:hover { transform: scale(1.1); }
  .vp-swatch:has(input:focus-visible) { outline: 2px solid var(--harbor); outline-offset: 2px; }
  .vp-swatch:has(input:checked) {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.12),
      0 0 0 2px var(--card),
      0 0 0 4px var(--harbor);
  }
  .vp-size {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono); font-size: 12.5px;
    min-width: 40px; padding: 8px 6px;
    border-radius: 4px; cursor: pointer;
    background: var(--canvas); color: var(--body);
  }
  .vp-size:hover:not(:has(input:checked)) { background: var(--line); color: var(--ink); }
  .vp-size:has(input:focus-visible) { outline: 2px solid var(--harbor); outline-offset: 1px; }
  .vp-size:has(input:checked) { background: var(--ink); color: var(--card); }
  .vp-add { width: 100%; }
  .vp-status {
    margin: 8px 0 0;
    min-height: 18px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--harbor);
  }
  @media (prefers-reduced-motion: reduce) {
    .vp-swatch { transition: none; }
    .vp-swatch:hover { transform: none; }
  }
</style>
