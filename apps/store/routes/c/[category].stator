---
import { CATEGORIES, type CategoryKey, type Product } from '../../lib/catalog-data.ts'
import {
  catalogHref,
  facetOptions,
  filterProducts,
  paginate,
  parseCatalogQuery,
} from '../../lib/filter.ts'
import CartMachine from '../../machines/cart.ts'
import CatalogMachine from '../../machines/catalog.ts'
import Layout from '../../templates/layout.stator'
import ProductCard from '../../templates/product-card.stator'

const [catalog, cart] = Stator.reads([CatalogMachine, CartMachine])
const { params, query } = Stator.request

const isAll = params.category === 'all'
const category = isAll ? undefined : (params.category as CategoryKey)
const cat = isAll
  ? { title: 'All goods', lede: 'The whole chandlery.' }
  : CATEGORIES[category as CategoryKey]
const base = `/c/${params.category}`
const q = parseCatalogQuery(query)
if (!cat) Stator.response.status = 404

const all = catalog.all
const filtered = cat ? filterProducts(all, category, q) : []
const page = paginate(filtered, q.page)
const facets = cat ? facetOptions(all, category, q) : { materials: [], colors: [], sizes: [] }
const hasFilters = Boolean(q.material || q.color || q.size)
---
<Layout cart={cart}>
  {when(!cat, () => (
    <section class="page-pad">
      <h1>No such aisle.</h1>
      <p><a href="/" class="link">Back to the front of the shop.</a></p>
    </section>
  ))}

  {when(!!cat, () => (
    <div>
      <header class="browse-head">
        <p class="eyebrow">{cat.title.toUpperCase()}</p>
        <h1>{cat.lede}</h1>
        <p class="count">
          {page.total} {page.total === 1 ? 'item' : 'items'}
          {hasFilters ? ' · filtered' : ''}
          {hasFilters ? ' — ' : ''}
          {when(hasFilters, () => <a href={base} class="link">clear filters</a>)}
        </p>
      </header>

      <div class="browse-body">
        <aside class="facets">
          <div>
            <h3>Material</h3>
            {each(facets.materials, (o) => (
              <a
                class:list={['facet', { 'is-on': q.material === o.value }]}
                href={catalogHref(base, q, { material: q.material === o.value ? null : o.value })}
              >
                {o.label} <span class="facet-count">{o.count}</span>
              </a>
            ))}
          </div>
          <div>
            <h3>Color</h3>
            {each(facets.colors, (o) => (
              <a
                class:list={['facet', { 'is-on': q.color === o.value }]}
                href={catalogHref(base, q, { color: q.color === o.value ? null : o.value })}
              >
                {o.label} <span class="facet-count">{o.count}</span>
              </a>
            ))}
          </div>
          <div>
            <h3>Size</h3>
            <div class="facet-sizes">
              {each(facets.sizes, (o) => (
                <a
                  class:list={['size', { 'is-on': q.size === o.value }]}
                  href={catalogHref(base, q, { size: q.size === o.value ? null : o.value })}
                >
                  {o.label}
                </a>
              ))}
            </div>
          </div>
        </aside>

        <section>
          {when(page.total === 0, () => (
            <p class="empty">Nothing matches that combination. <a href={base} class="link">Clear the filters</a> and try again.</p>
          ))}
          <div class="grid">
            {each(page.items, (p) => <ProductCard product={p} />)}
          </div>
          {when(page.pages > 1, () => (
            <nav class="pager">
              {when(page.page > 1, () => (
                <a class="pager-link" href={catalogHref(base, q, { page: page.page - 1 })}>← Previous</a>
              ))}
              <span class="pager-status">Page {page.page} of {page.pages}</span>
              {when(page.page < page.pages, () => (
                <a class="pager-link" href={catalogHref(base, q, { page: page.page + 1 })}>Next →</a>
              ))}
            </nav>
          ))}
        </section>
      </div>
    </div>
  ))}
</Layout>

<style>
  .browse-body {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 32px;
    align-items: start;
  }
  .facets {
    display: flex;
    flex-direction: column;
    gap: 22px;
    position: sticky;
    top: 20px;
  }
  .facets h3 {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--harbor);
    font-family: var(--mono);
    font-weight: 500;
    margin: 0 0 8px;
  }
  .facet {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    color: var(--body);
    padding: 3px 0;
  }
  .facet:hover {
    color: var(--ink);
  }
  .facet.is-on {
    color: var(--ink);
    font-weight: 600;
  }
  .facet.is-on::after {
    content: "×";
    color: var(--buoy);
    margin-left: 6px;
  }
  .facet-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--body);
  }
  .facet-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .size {
    font-family: var(--mono);
    font-size: 12px;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--body);
    background: var(--card);
  }
  .size:hover {
    border-color: var(--harbor);
    color: var(--ink);
  }
  .size.is-on {
    background: var(--ink);
    color: var(--card);
    border-color: var(--ink);
  }
  .pager {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 26px 0 0;
    font-size: 14px;
  }
  .pager-link {
    color: var(--harbor);
  }
  .pager-link:hover {
    text-decoration: underline;
  }
  .pager-status {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--body);
  }
  @media (max-width: 760px) {
    .browse-body {
      grid-template-columns: 1fr;
    }
    .facets {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
