# apps/store configuration.
# Copy to `.env` or `.env.local` (gitignored). Stator loads these at startup.

# Listen port. Default: 3000.
# PORT=3000

# Durable session + app state via Redis (production). Unset = in-memory (dev).
# REDIS_URL=redis://localhost:6379

# Enable the /admin route on a deploy (STORE_ADMIN=1). Always on in dev
# (NODE_ENV !== 'production').
# STORE_ADMIN=1
