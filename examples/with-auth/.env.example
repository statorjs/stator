# with-auth configuration.
# Copy to `.env` or `.env.local` (gitignored). Stator loads these at startup.

# All optional — the app runs with none of these set.

# SQLite database path for user accounts, relative to the directory the app is
# started from. Default: ./harbor.db
# WITH_AUTH_DB=./harbor.db

# Durable board, watches and sessions via Redis (production). Unset = in-memory:
# accounts survive a restart (they're in SQLite), the board and watches don't.
# REDIS_URL=redis://localhost:6379

# Per-session idle expiry, seconds. Default: 86400 (24h).
# SESSION_TTL_SECONDS=86400
