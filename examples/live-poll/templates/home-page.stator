---
import type { InstanceOf } from '@statorjs/stator/template'
import type PollsMachine from '../machines/polls.ts'
import PollCard from './poll-card.stator'

type Poll = {
  id: string
  question: string
  options: Array<{ id: string; text: string; count: number }>
  createdAt: number
}

const { polls } = Stator.props<{ polls: InstanceOf<typeof PollsMachine> }>()
---
<section>
  <header class="page-header">
    <h1>What do you want to ask?</h1>
    <p class="page-lede">
      Create a quick poll, share the link, and watch votes appear in real
      time.
    </p>
    <div><a href="/new" class="btn btn-primary">New poll →</a></div>
  </header>

  <section>
    <h2>Recent polls</h2>

    {when(
      read(polls, (p) => p.totalCount === 0),
      () => (
        <p class="empty">
          No polls yet. <a href="/new" class="link">Create the first one</a>.
        </p>
      ),
    )}

    <ul>
      {each(read(polls, (p) => p.all as Poll[]), (poll) => <PollCard poll={poll} />)}
    </ul>
  </section>
</section>

<style>
  div {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .empty {
    color: var(--muted);
    font-style: italic;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
