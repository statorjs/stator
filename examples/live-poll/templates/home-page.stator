---
import type { InstanceOf } from '@statorjs/stator/template'
import type PollsMachine from '../machines/polls.ts'

const { polls } = Stator.props<{ polls: InstanceOf<typeof PollsMachine> }>()
---
<section>
  <header class="page-header">
    <h1>What do you want to ask?</h1>
    <p class="page-lede">
      Create a quick poll, share the link, and watch votes appear in real
      time.
    </p>
    <div><a href="/new" class="btn btn-primary">New poll →</a></div>
  </header>

  <section>
    <h2>Recent polls</h2>

    {when(
      read(polls, (p) => p.totalCount === 0),
      () => (
        <p class="empty">
          No polls yet. <a href="/new" class="link">Create the first one</a>.
        </p>
      ),
    )}

    <ul>
      {/* Keyed, so a new poll is one inserted row and a vote is one patched
          number: the count is the row's only live field, read from the row. */}
      {each(
        read(polls, (p) => p.summaries),
        (poll) => (
          <li>
            <a href={`/p/${poll.id}`}>
              <strong>{poll.question}</strong>
              <small>{poll.options} options · {read(poll, (p) => p.votes)} votes</small>
            </a>
          </li>
        ),
        { key: (poll) => poll.id },
      )}
    </ul>
  </section>
</section>

<style>
  div {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .empty {
    color: var(--muted);
    font-style: italic;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
