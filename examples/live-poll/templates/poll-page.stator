---
import type { InstanceOf } from '@statorjs/stator/template'
import type PollsMachine from '../machines/polls.ts'
import type VoterMachine from '../machines/voter.ts'
import { pollOf } from '../lib/poll.ts'
import VotePanel from './vote-panel.stator'
import ResultsPanel from './results-panel.stator'

const { polls, voter, pollId } = Stator.props<{
  polls: InstanceOf<typeof PollsMachine>
  voter: InstanceOf<typeof VoterMachine>
  pollId: string
}>()
---
<section>
  {when(read(polls, (p) => !pollOf(p, pollId)), () => (
    <header class="page-header">
      <h1>Poll not found</h1>
      <p class="page-lede">No poll with that id exists.</p>
      <p><a href="/" class="link">Back to all polls</a></p>
    </header>
  ))}

  {when(read(polls, (p) => !!pollOf(p, pollId)), () => (
    <div>
      <header class="page-header">
        <h1>{read(polls, (p) => pollOf(p, pollId)?.question ?? '')}</h1>
        <p class="page-lede">
          {read(polls, (p) => {
            const poll = pollOf(p, pollId)
            if (!poll) return ''
            const total = poll.options.reduce((s, o) => s + o.count, 0)
            return `${total} vote${total === 1 ? '' : 's'}`
          })}
        </p>
      </header>

      {match(
        read(voter, (v) => ((v.votedFor as (id: string) => string | null)(pollId) ? 'voted' : 'voting')),
        {
          voting: () => <VotePanel polls={polls} voter={voter} pollId={pollId} />,
          voted: () => <ResultsPanel polls={polls} voter={voter} pollId={pollId} />,
        },
      )}

      <div class="share">
        <p>Share this poll:</p>
        <code>{pollId}</code>
      </div>
    </div>
  ))}
</section>

<style>
  .share {
    margin-top: 2rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .share p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    background: var(--bg);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
</style>
