---
import type { InstanceOf } from '@statorjs/stator/template'
import type PollsMachine from '../machines/polls.ts'
import type VoterMachine from '../machines/voter.ts'
import VotePanel from './vote-panel.stator'
import ResultsPanel from './results-panel.stator'

const { polls, voter, pollId } = Stator.props<{
  polls: InstanceOf<typeof PollsMachine>
  voter: InstanceOf<typeof VoterMachine>
  pollId: string
}>()
---
<section>
  <header class="page-header">
    <h1>{polls.byId(pollId)?.question}</h1>
    <p class="page-lede">
      {read(polls, (p) => {
        const total = p.votes(pollId)
        return `${total} vote${total === 1 ? '' : 's'}`
      })}
    </p>
  </header>

  {match(
    read(voter, (v) => (v.votedFor(pollId) ? 'voted' : 'voting')),
    {
      voting: () => <VotePanel polls={polls} voter={voter} pollId={pollId} />,
      voted: () => <ResultsPanel polls={polls} voter={voter} pollId={pollId} />,
    },
  )}

  <div class="share">
    <p>Share this poll:</p>
    <code>{pollId}</code>
  </div>
</section>

<style>
  .share {
    margin-top: 2rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .share p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    background: var(--bg);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
</style>
