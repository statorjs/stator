---
// @stator live
import PollsMachine from '../../machines/polls.ts'
import VoterMachine from '../../machines/voter.ts'
import Layout from '../../templates/layout.stator'
import PollPage from '../../templates/poll-page.stator'

const [polls, voter] = Stator.reads([PollsMachine, VoterMachine])
const pollId = Stator.request.params.id ?? ''
const found = polls.byId(pollId) !== undefined
if (!found) Stator.response.status = 404
---
<Layout>
  {found ? (
    <PollPage polls={polls} voter={voter} pollId={pollId} />
  ) : (
    <header class="page-header">
      <h1>Poll not found</h1>
      <p class="page-lede">No poll with that id exists.</p>
      <p><a href="/" class="link">Back to all polls</a></p>
    </header>
  )}
</Layout>
