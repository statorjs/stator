---
import PanelsMachine from '../machines/panels.ts'
import { raw } from '@statorjs/stator/template'
import type { InstanceOf } from '@statorjs/stator/template'

const { panels, placeId } = Stator.props<{
  panels: InstanceOf<typeof PanelsMachine>
  placeId: string
}>()
---
<div class="tile w4 press peek-tile" style="--c:#0050EF;--tc:#fff">
  <div class="slides">
    <div class="slide fc-slide">
      <div class="daily">
        <div class="drow drow-head"><span class="d-day">Next 5 days</span><span></span><span class="d-pop">Rain</span><span class="d-lo">Lo</span><span class="d-hi">Hi</span></div>
        {each(read(panels, (w) => w.dailyForId(placeId).slice(0, 5)), (d) => (
          <div class="drow"><div class="d-day"><span class="d-date num">{d.date}</span>{d.day}</div>{raw(d.icon)}<div class="d-pop"><span class="num">{d.precip}</span><span class="d-rain num">{d.rain}</span></div><div class="d-lo num">{d.lo}</div><div class="d-hi num">{d.hi}</div></div>
        ))}
      </div>
    </div>
    <div class="slide fc-slide">
      <div class="daily">
        <div class="drow drow-head"><span class="d-day">Days 6–10</span><span></span><span class="d-pop">Rain</span><span class="d-lo">Lo</span><span class="d-hi">Hi</span></div>
        {each(read(panels, (w) => w.dailyForId(placeId).slice(5, 10)), (d) => (
          <div class="drow"><div class="d-day"><span class="d-date num">{d.date}</span>{d.day}</div>{raw(d.icon)}<div class="d-pop"><span class="num">{d.precip}</span><span class="d-rain num">{d.rain}</span></div><div class="d-lo num">{d.lo}</div><div class="d-hi num">{d.hi}</div></div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* The 5-day rows. `.slide`/`.fc-slide` (peek frame) and `.peek-tile .slide`'s
     tiny-tile padding stay global — shared with the hourly tile. Row density
     steps down by the tile's real height (the global `.peek-tile` container).
     The weather glyph is a raw()-injected <svg class="wx-ico">, reached below by
     descendant selector. */
  .daily {
    flex: 1;
    display: grid;
    align-content: stretch;
    grid-auto-rows: 1fr;
  }
  .drow {
    display: grid;
    grid-template-columns: 1fr 26px 40px 32px 32px;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
  }
  .drow-head {
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    opacity: 0.6;
    padding-bottom: 3px;
  }
  .drow .wx-ico {
    width: 22px;
    height: 22px;
    opacity: 0.9;
    justify-self: center;
  }
  .d-day {
    font-size: 13.5px;
  }
  .d-date {
    display: inline-block;
    width: 1.5em;
    margin-right: 7px;
    text-align: right;
    opacity: 0.6;
  }
  .d-pop {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    line-height: 1.25;
    font-size: 11px;
    opacity: 0.85;
  }
  .d-rain {
    font-size: 9.5px;
    opacity: 0.7;
  }
  .d-lo {
    font-size: 13px;
    text-align: right;
    opacity: 0.65;
  }
  .d-hi {
    font-size: 13px;
    text-align: right;
    font-weight: 500;
  }
  /* Full rows (with the rain-amount sub-line) need ~215px of tile; below that
     drop the stacked sub-line and lay the amount inline with the probability. */
  @container tile (height < 216px) {
    .drow {
      grid-template-columns: 1fr 22px 76px 30px 30px;
      padding: 3px 0;
    }
    .drow .wx-ico {
      width: 18px;
      height: 18px;
    }
    .d-pop {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-end;
      gap: 4px;
    }
  }
  /* Tiny tiles: trade a few px of type for never clipping a row. */
  @container tile (height < 150px) {
    .drow {
      grid-template-columns: 1fr 18px 68px 28px 28px;
      padding: 2px 0;
    }
    .drow .wx-ico {
      width: 16px;
      height: 16px;
    }
    .d-day {
      font-size: 12px;
    }
    .d-rain {
      font-size: 8.5px;
    }
    .drow-head {
      font-size: 8.5px;
    }
  }
</style>
