---
import SettingsMachine from '../machines/settings.ts'
import PanelsMachine from '../machines/panels.ts'
import WeatherMachine from '../machines/weather.ts'
import SettingsControls from './settings-controls.stator'
import UpdatedAt from './updated-at.stator'
import type { InstanceOf } from '@statorjs/stator/template'

const { weather, settings, panels } = Stator.props<{
  weather: InstanceOf<typeof WeatherMachine>
  settings: InstanceOf<typeof SettingsMachine>
  panels: InstanceOf<typeof PanelsMachine>
}>()
---
{/* WP-style ApplicationBar. Three kinds of state meet here and stay in their
    lanes: which chrome mode is open is CLIENT machine state (AppBarCtl's
    ViewMode, projected as `data-view` on .wx — CSS renders every reveal);
    the units/clock inside the drawer are SERVER-canonical Settings state,
    live across tabs; refresh is a plain server event dispatch.
    Expansion follows the WP affordances — the "…" dots or any blank spot on
    the bar — with the gear kept as the discoverable route to the same drawer. */}
<div class="appbar">
  <div class="ab-inner">
  <div class="ab-row">
    <button class="ab-dots" type="button" aria-label="More" aria-expanded="false">
      <svg viewBox="0 0 24 6" aria-hidden="true">
        <circle cx="3" cy="3" r="2.2" fill="currentColor" />
        <circle cx="12" cy="3" r="2.2" fill="currentColor" />
        <circle cx="21" cy="3" r="2.2" fill="currentColor" />
      </svg>
    </button>
    <div class="ab-item">
      <button class="ab-btn ab-settings" type="button" aria-label="Settings" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.43.991a6.932 6.932 0 0 1 0 .255c-.008.379.137.75.43.991l1.004.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.49l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.281Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      </button>
      <span class="ab-label">settings</span>
    </div>
    <div class="ab-item">
      <button class="ab-btn ab-edit" type="button" aria-label="Edit locations" aria-pressed="false">
        <svg class="ab-glyph-pencil" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
        </svg>
        <svg class="ab-glyph-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </button>
      <span class="ab-label">edit</span>
    </div>
    <div class="ab-item">
      {/* Pressing this while already revalidating is guard-dropped by the
          machine (REVALIDATE is only handled in `ready`) — idempotent by
          state design, no client debounce needed. */}
      <button
        class:list={['ab-btn', 'ab-refresh', { spinning: read(panels, (p) => p.refreshing) }]}
        type="button"
        aria-label="Refresh weather"
        on:click={() => weather.send({ type: 'REVALIDATE' })}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
      </button>
      <span class="ab-label">refresh</span>
    </div>
  </div>
  <div class="ab-drawer-clip">
    <div class="ab-drawer" role="group" aria-label="Settings">
      <SettingsControls settings={settings} />
      <UpdatedAt at={read(panels, (p) => p.updatedAtMs)} clock={read(settings, (s) => s.clock)} />
    </div>
  </div>
  </div>
</div>

<style>
  /* The bar is fixed at the bottom, so it must reserve its own height on the
     page. `main` is the LAYOUT's element, not ours — the one place in the sweep
     that needs :global(), because the SUBJECT of the rule is a foreign element
     (subject-only scoping would otherwise stamp it and it'd never match). */
  :global(main) {
    padding-bottom: calc(104px + env(safe-area-inset-bottom));
  }
  .appbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: var(--bar-bg);
    color: var(--bar-fg);
    padding-bottom: env(safe-area-inset-bottom);
    /* The whole bar is a tap target (WP: any blank spot expands) — suppress the
       browser's accent tap flash; the drawer's motion is the feedback. */
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
  }
  /* Full-bleed bar, content-column alignment (the UWP CommandBar treatment): the
     inner box replicates main's centering + padding, and its children take the
     tile grid's exact width — so the dots ride the tiles' right edge and the
     drawer's rows start on their left edge. */
  .ab-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .ab-inner > * {
    width: calc(4 * var(--u) + 3 * 8px);
  }
  @media (min-width: 720px) {
    .ab-inner {
      padding: 0 clamp(24px, 4vw, 44px);
    }
    .ab-inner > * {
      width: calc(6 * var(--u) + 5 * 8px);
    }
  }
  .ab-row {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 30px;
    padding: 11px 0 12px;
  }
  /* WP's "…" affordance, top-right of the button row (which spans the tile grid,
     so the dots ride the tiles' right edge). */
  .ab-dots {
    position: absolute;
    top: 2px;
    right: 0;
    padding: 7px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .ab-dots svg {
    display: block;
    width: 22px;
    height: 6px;
  }
  .ab-dots:focus-visible {
    outline: 2px solid #1ba1e2;
    outline-offset: 2px;
  }
  .ab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }
  .ab-btn {
    width: 46px;
    height: 46px;
    padding: 0;
    border: 2px solid currentColor;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .ab-btn svg {
    width: 21px;
    height: 21px;
    display: block;
  }
  .ab-btn:focus-visible {
    outline: 2px solid #1ba1e2;
    outline-offset: 2px;
  }
  /* Labels appear under every button while the bar is expanded (settings view). */
  .ab-label {
    display: none;
    font-size: 11px;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }
  .wx[data-view="settings"] .ab-label {
    display: block;
  }
  /* Settings drawer: server-canonical toggles inside client-owned chrome. One
     physical panel, WP-style: the options print BELOW the buttons and the whole
     bar slides up to reveal them — the drawer's grid row grows from the bar's
     bottom anchor, so the icon row rides upward. */
  .ab-drawer-clip {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.25, 0.9, 0.25, 1);
  }
  .wx[data-view="settings"] .ab-drawer-clip {
    grid-template-rows: 1fr;
  }
  .ab-drawer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
    min-height: 0;
    overflow: hidden;
    /* Padding rides the slide — a border-box floors at its padding, so it must be
       0 for the 0fr track to fully close. Horizontal padding is 0: the ab-inner
       column already sets the tile-edge alignment. */
    padding: 0;
    cursor: default;
    /* Collapsed controls stay out of the tab order / a11y tree; the delay holds
       visibility until the slide finishes on the way shut. */
    visibility: hidden;
    transition:
      visibility 0s 0.28s,
      padding 0.28s cubic-bezier(0.25, 0.9, 0.25, 1);
  }
  .wx[data-view="settings"] .ab-drawer {
    padding: 4px 0 16px;
    visibility: visible;
    transition:
      visibility 0s,
      padding 0.28s cubic-bezier(0.25, 0.9, 0.25, 1);
  }
  /* Edit is a mode: the pencil fills solid and swaps to a check while active.
     (`.ab-btn` prefix so this outranks the `.ab-btn svg` display:block above.) */
  .ab-btn .ab-glyph-check {
    display: none;
  }
  .wx[data-view="editing"] .ab-edit {
    background: var(--bar-fg);
    color: var(--bar-bg);
  }
  .wx[data-view="editing"] .ab-edit .ab-glyph-pencil {
    display: none;
  }
  .wx[data-view="editing"] .ab-edit .ab-glyph-check {
    display: block;
  }
  /* The spinner has two layers. [data-stator-pending] is THIS tab's request in
     flight — runtime-owned, spinning the instant you tap. .spinning is SERVER
     state (weather.refreshing over SSE) — every open tab sees a refresh in
     flight, whoever started it. Patches apply before the pending attribute
     clears, so the handoff never gaps. */
  .ab-refresh[data-stator-pending] svg,
  .ab-refresh.spinning svg {
    animation: ab-spin 1s linear infinite;
  }
  @keyframes ab-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ab-refresh[data-stator-pending] svg,
    .ab-refresh.spinning svg {
      animation: none;
    }
    .ab-drawer-clip,
    .ab-drawer {
      transition: none;
    }
  }
</style>
