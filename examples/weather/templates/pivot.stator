---
import PanelsMachine from '../machines/panels.ts'
import WeatherMachine from '../machines/weather.ts'
import type { InstanceOf } from '@statorjs/stator/template'

const { weather, panels } = Stator.props<{
  weather: InstanceOf<typeof WeatherMachine>
  panels: InstanceOf<typeof PanelsMachine>
}>()
---
<nav class="pivot" aria-label="Saved locations">
  {each(
    read(weather, (w) => w.places),
    (p) => (
      <button class="pivot-item" data-id={p.id}>
        <span class="pivot-name">{p.name}</span>
        <span class="pivot-temp num">{read(panels, (w) => w.panelForId(p.id).temp)}</span>
        <span
          class="pivot-remove"
          role="button"
          aria-label="Remove location"
          on:click={() => weather.send({ type: 'REMOVE_PLACE', id: p.id })}
        ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6 18 18M18 6 6 18" /></svg></span>
      </button>
    ),
    { key: (p) => p.id },
  )}
</nav>

<style>
  .pivot {
    display: flex;
    gap: 22px;
    margin: 2px 0 22px;
    padding-bottom: 6px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pivot::-webkit-scrollbar {
    display: none;
  }
  .pivot-item {
    scroll-snap-align: start;
    flex: 0 0 auto;
    display: flex;
    align-items: baseline;
    gap: 9px;
    background: transparent;
    border: 0;
    padding: 2px 0;
    cursor: pointer;
    font-family: inherit;
    color: var(--fg-2);
    opacity: 0.45;
    transition: opacity 0.2s;
  }
  .pivot-item:hover {
    opacity: 0.8;
  }
  .pivot-item.active {
    opacity: 1;
  }
  .pivot-name {
    font-size: clamp(21px, 4vw, 30px);
    font-weight: 200;
    letter-spacing: -0.01em;
  }
  .pivot-item.active .pivot-name {
    color: var(--fg);
  }
  .pivot-temp {
    font-size: 14px;
    color: var(--fg-2);
    font-weight: 400;
  }
  .pivot-item:focus-visible {
    outline: 2px solid #1ba1e2;
    outline-offset: 3px;
  }
  /* Touch devices: fingers need a bigger vertical hit area on the pills. */
  @media (pointer: coarse) {
    .pivot-item {
      padding: 9px 0;
    }
  }
  /* Edit mode — a view-cascade off the route's .wx[data-view]. The pills gain a
     chip outline and reveal a ✕ delete chip. The ✕'s ACTION is a real
     REMOVE_PLACE event; only its VISIBILITY is client view state. */
  .pivot-remove {
    display: none;
  }
  .wx[data-view="editing"] .pivot-item {
    padding: 4px 6px 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .wx[data-view="editing"] .pivot-remove {
    display: inline-flex;
    align-self: center;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(127, 127, 127, 0.25);
    color: var(--fg);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    animation: edit-pop-in 0.2s ease-out;
  }
  .wx[data-view="editing"] .pivot-remove:hover {
    background: #d64545;
    color: #fff;
  }
  .pivot-remove svg {
    display: block;
    width: 11px;
    height: 11px;
  }
  @keyframes edit-pop-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
