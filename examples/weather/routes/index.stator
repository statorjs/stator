---
// @stator live
import SearchMachine from '../machines/search.ts'
import SettingsMachine from '../machines/settings.ts'
import PanelsMachine from '../machines/panels.ts'
import WeatherMachine from '../machines/weather.ts'
import AppBar from '../templates/app-bar.stator'
import AppBarCtl from '../templates/app-bar-ctl.stator'
import Layout from '../templates/layout.stator'
import Panel from '../templates/panel.stator'
import Pivot from '../templates/pivot.stator'
import PivotCtl from '../templates/pivot-ctl.stator'
import RefreshClock from '../templates/refresh-clock.stator'
import SearchBar from '../templates/search-bar.stator'

const [weather, settings, search, panels] = Stator.reads([WeatherMachine, SettingsMachine, SearchMachine, PanelsMachine])
---
<Layout>
  <section class="wx">
    <header>
      <div class="eyebrow"><span class="eb-rest">weather</span><span class="eb-edit">edit locations</span></div>
      <h1>{read(weather, (w) => w.active?.name ?? '—')}</h1>
      <div class="sub">
        {read(weather, (w) =>
          w.active ? (w.active.admin ? `${w.active.admin}, ${w.active.country}` : w.active.country) : '',
        )}
      </div>

      <SearchBar weather={weather} search={search} />
    </header>

    {/* Pivot headers — native scroll-snap strip; PivotCtl highlights the centred
        panel and scrolls one into view on click. Scroll position is the truth. */}
    <Pivot weather={weather} panels={panels} />

    {/* Panorama: one full panel per location, swiped with native CSS scroll-snap. */}
    <div class="panorama" aria-label="Locations">
      {each(
        read(weather, (w) => w.places),
        (p) => (
          <Panel panels={panels} placeId={p.id} />
        ),
        { key: (p) => p.id },
      )}
    </div>

    <PivotCtl />

    {/* WP ApplicationBar: settings drawer, edit mode, refresh. Its chrome
        state lives in AppBarCtl's client machine. */}
    <AppBar weather={weather} settings={settings} panels={panels} />
    <AppBarCtl />
    <RefreshClock />
  </section>
</Layout>

<style>
  /* The page header. `.panorama`/`.panel` (the carousel structure) stay global,
     shared with the tile grid. */
  header {
    margin-bottom: 24px;
  }
  .eyebrow {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--fg-2);
    font-weight: 600;
  }
  h1 {
    margin: 2px 0 0;
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .sub {
    margin-top: 8px;
    color: var(--fg-2);
    font-size: 14px;
  }
  /* The eyebrow names the mode: "weather" → "edit locations". `data-view` lives
     on this route's own .wx section (set by the app-bar's client machine); the
     ancestor selector stays unscoped, so the reveal works from here. */
  .eb-edit {
    display: none;
  }
  .wx[data-view="editing"] .eb-rest {
    display: none;
  }
  .wx[data-view="editing"] .eb-edit {
    display: inline;
  }
</style>
