# weather configuration.
# Copy to `.env` or `.env.local` (gitignored). Stator loads these at startup.
# All optional — the app runs on in-memory state with none of these set.

# Durable session state via Redis (production). Unset = in-memory (dev default).
# REDIS_URL=redis://localhost:6379

# Per-session idle expiry, seconds. Default: 86400 (24h).
# SESSION_TTL_SECONDS=86400
