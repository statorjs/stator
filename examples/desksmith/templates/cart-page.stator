---
import type { InstanceOf } from '@statorjs/stator/template'
import type CartMachine from '../machines/cart.ts'

const { cart } = Stator.props<{ cart: InstanceOf<typeof CartMachine> }>()
---
<section>
  <header>
    <h1>Your cart</h1>
    <p>
      {read(cart, c => c.itemCount)} item{read(cart, c => c.itemCount === 1 ? '' : 's')} · subtotal{' '}
      <strong>${read(cart, c => c.total.toFixed(2))}</strong>
    </p>
  </header>

  {when(read(cart, c => c.isEmpty), () =>
    <div class="empty">
      <p>Your cart is empty.</p>
      <a href="/">← Browse products</a>
    </div>
  )}

  {/* Keyed rows: a quantity change patches that row's quantity and total.
      Item reads only work inline in their each, so the row lives here. */}
  <ul>
    {each(
      read(cart, c => c.lines),
      (line) => (
        <li>
          <div class={`thumb product-thumb--${line.category}`}>
            <span class="product-thumb-initials">{line.initials}</span>
          </div>
          <div class="info">
            <span class="name">{line.name}</span>
            <span class="unit">${line.unitPrice.toFixed(2)} each</span>
          </div>
          <div class="qty">
            <button on:click={() => cart.send({ type: 'DECREMENT', productId: line.productId })}>−</button>
            <span>{read(line, l => l.quantity)}</span>
            <button on:click={() => cart.send({ type: 'INCREMENT', productId: line.productId })}>+</button>
          </div>
          <div class="total">${read(line, l => l.lineTotal.toFixed(2))}</div>
          <button on:click={() => cart.send({ type: 'REMOVE_ITEM', productId: line.productId })} title="Remove">×</button>
        </li>
      ),
      { key: (line) => line.productId },
    )}
  </ul>

  {when(read(cart, c => !c.isEmpty), () =>
    <footer>
      <div class="totals">
        <div>
          <span>Subtotal</span>
          <span>${read(cart, c => c.total.toFixed(2))}</span>
        </div>
        <div class="muted">
          <span>Shipping calculated at checkout</span>
        </div>
        <div class="grand">
          <span>Estimated total</span>
          <span>${read(cart, c => c.total.toFixed(2))}</span>
        </div>
      </div>
      <div class="actions">
        <button class="btn-secondary" on:click={() => cart.send({ type: 'CLEAR' })}>Clear cart</button>
        <a href="/checkout" class="btn-primary">Checkout →</a>
      </div>
    </footer>
  )}
</section>

<style>
  header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  header p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 1rem;
  }
  header p strong {
    color: var(--text);
    font-weight: 600;
  }
  .empty {
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
    color: var(--muted);
  }
  .empty a {
    display: inline-block;
    margin-top: 0.75rem;
    text-decoration: none;
    color: var(--accent-strong);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: grid;
    grid-template-columns: 64px 1fr auto auto auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  li:last-child {
    border-bottom: none;
  }
  .thumb {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Georgia", "Times New Roman", serif;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
  }
  .info {
    display: flex;
    flex-direction: column;
  }
  .name {
    font-weight: 500;
  }
  .unit {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .qty {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.15rem;
  }
  .qty button {
    border: none;
    background: transparent;
    width: 28px;
    height: 28px;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
    color: var(--muted);
    border-radius: 4px;
  }
  .qty button:hover {
    background: var(--surface);
    color: var(--text);
  }
  .qty span {
    min-width: 2ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }
  .total {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    min-width: 70px;
    text-align: right;
  }
  /* the remove ✕ — the only direct-child button of the row */
  li > button {
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--muted-2);
    font-size: 1.2rem;
    line-height: 1;
  }
  li > button:hover {
    background: #f2e9e9;
    color: #b85b5b;
  }
  footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .totals {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 360px;
    margin-left: auto;
  }
  .totals > div {
    display: flex;
    justify-content: space-between;
    font-variant-numeric: tabular-nums;
  }
  .totals > .muted {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .totals > .grand {
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
</style>
