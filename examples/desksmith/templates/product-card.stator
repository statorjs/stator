---
import type { InstanceOf } from '@statorjs/stator/template'
import type CartMachine from '../machines/cart.ts'

type Product = {
  id: string
  name: string
  description: string
  price: number
  category: 'stationery' | 'office' | 'lifestyle'
  initials: string
}

const { product, cart } = Stator.props<{
  product: Product
  cart: InstanceOf<typeof CartMachine>
}>()
---
<li>
  <div class={`thumb product-thumb--${product.category}`}>
    <span class="product-thumb-initials">{product.initials}</span>
  </div>
  <div class="body">
    <h3>{product.name}</h3>
    <p>{product.description}</p>
    <div class="footer">
      <span class="price">${product.price.toFixed(2)}</span>
      <button
        on:click={() => cart.send({ type: 'ADD_ITEM', productId: product.id })}
        class:list={{ 'add-btn': true, 'in-cart': read(cart, c => c.contains(product.id)) }}
      >
        {read(cart, c => c.contains(product.id) ? 'In cart ✓' : 'Add to cart')}
      </button>
    </div>
  </div>
</li>

<style>
  li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  li:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  /* base thumb layout; the per-category color block (product-thumb--*) is a
     shared global primitive because the cart line reuses it too. */
  .thumb {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Georgia", "Times New Roman", serif;
    font-weight: 500;
    font-size: 1.6rem;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--border);
  }
  .body {
    padding: 1rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  h3 {
    margin-bottom: 0.3rem;
  }
  p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 1rem;
    flex: 1;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .price {
    font-weight: 600;
    font-size: 1.05rem;
  }
</style>
