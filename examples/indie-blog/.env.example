# indie-blog configuration.
# Copy to `.env` (committed defaults) or `.env.local` (gitignored, for secrets).
# Stator loads these at startup — real shell env wins, then .env.local, then .env.

# Owner login password — hashed once at boot; logins verify against the hash.
# CHANGE THIS: the code's fallback is a public dev-only value.
INDIE_BLOG_PASSWORD=change-me

# Public identity, shown on every page.
INDIE_BLOG_NAME=An Indie Blog
INDIE_BLOG_AUTHOR=The Author

# Absolute origin the site is served from — webmention targets must live under
# it, and outgoing mentions cite post URLs built on it.
INDIE_BLOG_ORIGIN=http://localhost:3007

# SQLite database path.
INDIE_BLOG_DB=indie-blog.db

# Extra webmention targets every published post also notifies (comma-separated —
# e.g. brid.gy publish endpoints for silo syndication). Empty = none.
# INDIE_BLOG_SYNDICATE=https://brid.gy/publish/mastodon
