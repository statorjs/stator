---
// @stator live
import DeskMachine from '../machines/desk.ts'
import RosterMachine from '../machines/roster.ts'
import Layout from '../templates/layout.stator'
import RegForm from '../templates/reg-form.stator'
import RowSeats from '../templates/row-seats.stator'

const [desk, roster] = Stator.reads([DeskMachine, RosterMachine])
---
<Layout>
  <header>
    <h1>The Front Desk</h1>
    <p>
      One roster, shared by every open desk — register in one window and the
      row appears in all of them. The form checks your typing as you go, and
      the desk checks everything again before a seat is taken.
    </p>
    <p data-seats>
      <strong>{read(roster, (r) => r.seatsLeft)}</strong> of{' '}
      {read(roster, (r) => r.capacity)} seats left
      {when(read(roster, (r) => r.isFull), () => (
        <em>sold out</em>
      ))}
    </p>
  </header>

  <RegForm />

  <section aria-label="Roster">
    <h2>on the roster · {read(roster, (r) => r.count)}</h2>
    <ol>
      {/* Every field an edit can change is an item read, so an UPDATE patches
          the row in place on every open desk. Item reads only work inline in
          the each(), which is why the row is not its own component. */}
      {each(
        read(roster, (r) => r.attendees),
        (attendee) => (
          <li>
            <div>
              <strong><a href={`/edit/${attendee.id}`}>{read(attendee, (a) => a.name)}</a></strong>
              <span>{read(attendee, (a) => a.email)} · <code>{attendee.id}</code></span>
            </div>
            <small data-ticket={read(attendee, (a) => a.ticket)}>{read(attendee, (a) => a.ticket)}</small>
            {/* An island's live attr takes a machine read; an item read can't
                cross into the island. */}
            <RowSeats
              rid={attendee.id}
              seats={read(roster, (r) => r.attendees.find((a) => a.id === attendee.id)?.seats ?? 0)}
            />
            <a data-edit href={`/edit/${attendee.id}`} aria-label={read(attendee, (a) => `Edit ${a.name}`)}>✎</a>
            <button
              type="button"
              data-remove
              aria-label={read(attendee, (a) => `Remove ${a.name}`)}
              on:click={() => desk.send({ type: 'REMOVE', id: attendee.id })}
            >
              ×
            </button>
          </li>
        ),
        { key: (attendee) => attendee.id },
      )}
    </ol>
  </section>

  <footer>
    <p>
      A forms proving ground — shape rules shared by browser and server, truth
      rules server-only — built with <a href="https://statorjs.dev">Stator</a>.
    </p>
  </footer>
</Layout>

<style>
  header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }
  header p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 32rem;
  }
  p[data-seats] {
    margin: 1.1rem 0 1.6rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
  }
  p[data-seats] strong {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  p[data-seats] em {
    font-style: normal;
    color: var(--error);
    margin-left: 0.5rem;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  section {
    margin-top: 2.2rem;
  }
  h2 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    font-weight: normal;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.4rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.2rem;
    border-bottom: 1px solid var(--rule);
  }
  li > div {
    flex: 1;
    display: grid;
  }
  li strong {
    font-weight: 600;
  }
  li strong a {
    color: var(--ink);
    text-decoration: none;
  }
  li strong a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  li span {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  li code {
    font-size: 0.7rem;
    color: var(--ink-faint);
  }
  li small {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }
  li small[data-ticket='vip'] {
    color: var(--accent);
    border-color: var(--accent);
  }
  li button,
  li a[data-edit] {
    font: inherit;
    line-height: 1;
    color: var(--ink-faint);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    text-decoration: none;
  }
  li a[data-edit]:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  li button[data-remove]:hover {
    color: var(--error);
    border-color: var(--error);
  }
  footer {
    margin-top: 3rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  footer p {
    margin: 0;
  }
  footer a {
    color: var(--ink-soft);
  }
</style>
