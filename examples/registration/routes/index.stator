---
// @stator live
import { TICKETS } from '../lib/rules.ts'
import DeskMachine from '../machines/desk.ts'
import RosterMachine from '../machines/roster.ts'
import AttendeeRow from '../templates/attendee-row.stator'
import Layout from '../templates/layout.stator'
import RegForm from '../templates/reg-form.stator'

const [desk, roster] = Stator.reads([DeskMachine, RosterMachine])
---
<Layout>
  <header>
    <h1>The Front Desk</h1>
    <p>
      One roster, shared by every open desk — register in one window and the
      row appears in all of them. The form checks your typing as you go, and
      the desk checks everything again before a seat is taken.
    </p>
    <p data-seats>
      <strong>{read(roster, (r) => r.seatsLeft)}</strong> of{' '}
      {read(roster, (r) => r.capacity)} seats left
      {when(read(roster, (r) => r.isFull), () => (
        <em>sold out</em>
      ))}
    </p>
  </header>

  <RegForm tickets={TICKETS} />

  {when(read(desk, (d) => d.hasRegistered), () => (
    <p role="status">
      You're on the list, <strong>{read(desk, (d) => d.lastRegistered)}</strong>.
    </p>
  ))}

  <section aria-label="Roster">
    <h2>on the roster · {read(roster, (r) => r.count)}</h2>
    <ol>
      {each(
        read(roster, (r) => r.attendees),
        (attendee) => <AttendeeRow attendee={attendee} desk={desk} />,
        { key: (attendee) => attendee.id },
      )}
    </ol>
  </section>

  <footer>
    <p>
      A forms proving ground — shape rules shared by browser and server, truth
      rules server-only — built with <a href="https://statorjs.dev">Stator</a>.
    </p>
  </footer>
</Layout>

<style>
  header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }
  header p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 32rem;
  }
  p[data-seats] {
    margin: 1.1rem 0 1.6rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
  }
  p[data-seats] strong {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  p[data-seats] em {
    font-style: normal;
    color: var(--error);
    margin-left: 0.5rem;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  p[role='status'] {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--ok);
  }
  section {
    margin-top: 2.2rem;
  }
  h2 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    font-weight: normal;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.4rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  footer {
    margin-top: 3rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  footer p {
    margin: 0;
  }
  footer a {
    color: var(--ink-soft);
  }
</style>
