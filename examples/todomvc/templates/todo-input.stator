<todo-input>
  <input
    class="new-todo"
    placeholder="What needs doing?"
    autofocus
    ref:draft
    on:keydown={maybeSubmit}
  />
</todo-input>

<script>
  import TodosMachine from '../machines/todos.ts'

  // The doctrine, in one file: the INPUT owns the draft — every keystroke
  // stays client-side with zero machinery, and the platform (maxlength,
  // required, …) is the draft's guard. Enter commits one typed dispatch.
  // Only a COMMITTED add clears the field — a guard-dropped or failed
  // dispatch keeps your typing. That clear is the safe writeback moment.
  export class TodoInput extends StatorElement {
    async maybeSubmit(e: KeyboardEvent) {
      if (e.key !== 'Enter') return
      const input = e.currentTarget as HTMLInputElement
      const title = input.value.trim()
      if (!title) return
      const result = await dispatch(TodosMachine, { type: 'ADD', title })
      if (result.committed) input.value = ''
    }
  }
</script>
